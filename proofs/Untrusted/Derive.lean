/- `derive_decode_spec S`: proves that the `Decode` impl of the structure `S`
   decodes `S`'s fields one after another, in declaration order.

   The statement is built from the structure as Aeneas translated it (field
   order and declared field types) and the field types' own `DecodesAs`
   instances; nothing comes from the derive macro. The proof is a generated
   tactic script, checked by Lean's kernel like any other proof, so this
   command is not part of the trusted base. The generated text is logged so
   that it can be reviewed. -/
import Untrusted.Proofs.DecodesAs

open Lean Elab Command Meta

register_option untrusted.derive.show : Bool := {
  defValue := false
  descr := "log the declarations generated by `derive_decode_spec`"
}

namespace untrusted.derive

/-- The `Decode` impl constants of the environment, keyed by their exact,
    unreduced `Decode T` type: Aeneas makes `BigEndian T` and `LittleEndian T`
    reduce to `T`, so the lookup must not unfold anything. -/
def decodeImpls (env : Environment) : Array (Expr × Name) := Id.run do
  let mut out := #[]
  for (n, info) in env.constants.toList do
    if let .app (.const ``untrusted.reader.Decode _) t := info.type then
      if !n.isInternal then out := out.push (t, n)
  return out

/-- The unique `Decode` impl for the field type `t`. -/
def implFor (impls : Array (Expr × Name)) (t : Expr) : CommandElabM Name := do
  match impls.filter (·.1 == t) with
  | #[(_, n)] => return n
  | #[] => throwError "no `Decode` impl found for field type {t}"
  | ms => throwError "several `Decode` impls for field type {t}: {ms.map (·.2)}"

/-- The function a `Decode` impl record points to, e.g. `S.Insts.UntrustedReaderDecode.decode`. -/
def decodeFnOf (env : Environment) (inst : Name) : CommandElabM Name := do
  let some (.defnInfo d) := env.find? inst | throwError "{inst} is not a definition"
  match d.value.getAppFn, d.value.getAppArgs.back? with
  | .const _ _, some (.const f _) => return f
  | _, _ => throwError "unexpected shape for the `Decode` impl {inst}"

def nestSeq (items : List String) (nil : String) (f : String → String → String) : String :=
  items.foldr f nil

/-- The generated declarations for type `S` with impl `inst`. Each field is
    given by how to access it from `v : S` and its `Decode` impl; `inj` proves
    that `S.fields` is injective. -/
def render (S inst decodeFn : Name) (fields : List (String × Name)) (inj : String) : String :=
  let s := toString S
  let fieldsTuple :=
    "(" ++ String.intercalate ", " (fields.map (·.1)) ++
      (if fields.isEmpty then "" else ", ") ++ "())"
  let insts := fields.map fun (_, i) => toString i
  let D := nestSeq insts "Dnil" fun i acc => s!"(Dseq (FmtD {i}) {acc})"
  let F := nestSeq insts "Fnil" fun i acc => s!"(Fseq (FmtD {i}) (FmtF {i}) {acc})"
  let laws := nestSeq insts "Laws.nil" fun i acc => s!"((FmtLaws {i}).seq {acc})"
  let n := fields.length
  let ind (d : Nat) := String.ofList (List.replicate (4 + 2 * d) ' ')
  -- `(Reader.rest r).drop k1 |>.drop k2 ...`
  let restAfter (i : Nat) := (List.range i).foldl (fun acc j => s!"({acc}).drop k{j+1}") "Reader.rest r"
  let fseqErr (i : Nat) :=
    ((List.range (i - 1)).foldr (fun j acc => s!"Fseq.later hD{j+1} ({acc})") s!"Fseq.here hF{i}")
  let dseqOk :=
    (List.range n).foldr (fun j acc => s!"Dseq.intro hD{j+1} ({acc})") "Dnil.intro _"
  let rec steps (i : Nat) (fuel : Nat) : String :=
    match fuel with
    | 0 => ""
    | fuel + 1 =>
      let d := i - 1
      let rPrev := if i = 1 then "r" else s!"r{i-1}"
      let hinvPrev := if i = 1 then "hinv" else s!"hinv{i-1}"
      let inst := insts[i-1]!
      let head :=
        s!"{ind d}apply WP.spec_bind (Reader.decode.spec {inst} {rPrev} {hinvPrev})\n" ++
        s!"{ind d}rintro ⟨res{i}, r{i}⟩ h{i}\n" ++
        s!"{ind d}simp only [WP.uncurry'_pair, uncurry] at h{i} ⊢\n" ++
        (if i = 1 then "" else s!"{ind d}rw [hrest{i-1}] at h{i}\n") ++
        s!"{ind d}cases res{i}\n"
      let okHead :=
        s!"{ind d}· obtain ⟨k{i}, hD{i}, hin{i}, hpos{i}, hinv{i}⟩ := h{i}\n" ++
        s!"{ind (d+1)}simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_ok]\n" ++
        s!"{ind (d+1)}have hrest{i} : Reader.rest r{i} = {restAfter i} := by\n" ++
        s!"{ind (d+2)}rw [Reader.rest_advance {rPrev} r{i} k{i} hin{i} hpos{i}" ++
          (if i = 1 then "]\n" else s!", hrest{i-1}]\n") ++
        s!"{ind (d+1)}have hinT{i} : r{i}.input = r.input := " ++
          (if i = 1 then "hin1\n" else s!"hin{i}.trans hinT{i-1}\n")
      let okTail :=
        if i = n then
          s!"{ind (d+1)}simp only [bind_ok, WP.spec_ok, WP.uncurry'_pair]\n" ++
          s!"{ind (d+1)}refine ⟨hinT{n}, hinv{n}, _, {dseqOk}, ?_⟩\n" ++
          s!"{ind (d+1)}scalar_tac\n"
        else steps (i + 1) fuel
      let err :=
        s!"{ind d}· obtain ⟨hF{i}, rfl⟩ := h{i}\n" ++
        s!"{ind (d+1)}simp only [core.result.Result.Insts.CoreOpsTry.branch, bind_ok,\n" ++
        s!"{ind (d+2)}core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual,\n" ++
        s!"{ind (d+2)}core.convert.FromSame.from, bind_tc_ok, WP.spec_ok, WP.uncurry'_pair]\n" ++
        s!"{ind (d+1)}exact ⟨" ++ (if i = 1 then "trivial" else s!"hinT{i-1}") ++
          s!", {hinvPrev}, {fseqErr i}⟩\n"
      head ++ okHead ++ okTail ++ err
  let specProof :=
    if n = 0 then
      s!"    simp only [{decodeFn}, WP.spec_ok, WP.uncurry'_pair]\n" ++
      "    exact ⟨by simp, hinv, 0, Dnil.intro _, by simp⟩\n"
    else
      s!"    simp only [{decodeFn}]\n" ++ steps 1 n
  let opts :=
    "set_option linter.unusedSimpArgs false in\n" ++
    "set_option linter.unusedVariables false in\n" ++
    "set_option linter.unnecessarySeqFocus false in\n" ++
    "open Aeneas Aeneas.Std Result untrusted untrusted.reader in\n"
  opts ++
  s!"/-- `{s}` viewed as the tuple of its fields, in declaration order. -/\n" ++
  s!"def _root_.{s}.fields (v : {s}) := {fieldsTuple}\n\n" ++
  opts ++
  s!"theorem _root_.{s}.fields_injective : Function.Injective {s}.fields := by\n" ++
  s!"  {inj}\n\n" ++
  opts ++
  s!"/-- **Spec theorem for the derived `<{s} as Decode>::decode`**: decodes the fields\n" ++
  s!"    of `{s}` one after another, in declaration order. -/\n" ++
  s!"instance _root_.{inst}.decode.spec :\n" ++
  s!"    DecodesAs {inst}\n" ++
  s!"      (fun l v k => {D} l ({s}.fields v) k)\n" ++
  s!"      {F} where\n" ++
  s!"  spec r hinv := by\n" ++ specProof ++
  s!"  disjoint := ({laws}.map _ {s}.fields_injective).disjoint\n" ++
  s!"  functional := ({laws}.map _ {s}.fields_injective).functional\n"

/-- Splits `T1 × (T2 × … × Tn)` into its components. -/
partial def prodComponents (t : Expr) : List Expr :=
  match t.getAppFn, t.getAppArgs with
  | .const ``Prod _, #[a, b] => a :: prodComponents b
  | _, _ => [t]

/-- The fields of `S`, in declaration order, as accessors on `v : S` with their
    types, and a proof that viewing `S` as the tuple of its fields is injective.
    Aeneas translates Rust structs with named fields to structures, tuple structs
    to products `T1 × … × Tn`, and unit structs to `Unit`. -/
def fieldsOf (env : Environment) (S : Name) :
    CommandElabM (List (String × Expr) × String) := do
  let names (n : Nat) (p : String) := String.intercalate ", " ((List.range n).map (s!"{p}{·}"))
  -- Destructure both sides, split the tuple equation, substitute.
  let inj (n : Nat) :=
    if n == 0 then "intro a b _; cases a; cases b; rfl" else
    s!"intro a b h; rcases a with ⟨{names n "a"}⟩; rcases b with ⟨{names n "b"}⟩; " ++
    s!"simp only [{S}.fields, Prod.mk.injEq, and_true] at h; " ++
    s!"obtain ⟨{String.intercalate ", " (List.replicate n "rfl")}⟩ := h; rfl"
  if getStructureInfo? env S |>.isSome then
    let fs ← (getStructureFields env S).toList.mapM fun f => do
      let some (.defnInfo d) := env.find? (S ++ f) | throwError "no projection {S ++ f}"
      let .forallE _ _ t _ := d.type | throwError "unexpected projection type for {f}"
      return (s!"v.{f}", t)
    return (fs, inj fs.length)
  let some (.defnInfo d) := env.find? S | throwError "{S} is not a type definition"
  if d.value == .const ``Unit [] then
    return ([], "intro a b _; rfl")
  let ts := prodComponents d.value
  let n := ts.length
  if n == 1 then
    return ([("v", d.value)],
      s!"intro a b h; simp only [{S}.fields, Prod.mk.injEq, and_true] at h; exact h")
  let acc (i : Nat) := "v" ++ String.join (List.replicate i ".2") ++ (if i + 1 < n then ".1" else "")
  return ((List.range n).zip ts |>.map fun (i, t) => (acc i, t), inj n)

/-- Proves that the `Decode` impl of `S` decodes its fields in order. -/
elab "derive_decode_spec " id:ident : command => do
  let env ← getEnv
  let S ← liftCoreM <| realizeGlobalConstNoOverload id
  let impls := decodeImpls env
  let inst ← implFor impls (.const S [])
  let decodeFn ← decodeFnOf env inst
  let (fs, inj) ← fieldsOf env S
  let fields ← fs.mapM fun (a, t) => return (a, ← implFor impls t)
  let text := render S inst decodeFn fields inj
  if untrusted.derive.show.get (← getOptions) then
    logInfo m!"derive_decode_spec {S}:\n{text}"
  -- Elaborate the generated commands one after another.
  let inputCtx := Parser.mkInputContext text "<derive_decode_spec>"
  let mut state : Parser.ModuleParserState := {}
  repeat
    let (stx, st', msgs) :=
      Parser.parseCommand inputCtx { env := (← getEnv), options := {} } state {}
    state := st'
    for m in msgs.toList do logMessage m
    if stx.isOfKind ``Parser.Command.eoi then break
    elabCommand stx

end untrusted.derive
