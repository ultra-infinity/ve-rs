instance _root_.untrusted.bytes.LittleEndianI64.roundtrip :
    RoundTrip LittleEndianI64.Insts.UntrustedWriterEncode LittleEndianI64.Insts.UntrustedReaderDecode (fun _ => True) where
  roundtrip x rest _ := by
    refine ⟨by simp, by simp, ?_⟩
    rw [List.take_left' (by simp), leNat_leBytes, Nat.mod_eq_of_lt (by simpa using (x : I64).bv.isLt)]
    simp

/-- **Spec theorem for `<LittleEndian<i128> as Encode>::encode`**: the 16 bytes it is
    decoded from. -/
instance _root_.untrusted.bytes.LittleEndianI128.Insts.UntrustedWriterEncode.encode.spec :
    EncodesAs LittleEndianI128.Insts.UntrustedWriterEncode (fun x => leBytes 16 (x : I128).bv.toNat) where
  spec v w hinv := by
    simp only [LittleEndianI128.Insts.UntrustedWriterEncode.encode, lift, bind_ok]
    apply WP.spec_bind (Writer.write_le.spec w _ 16#usize hinv)
    rintro ⟨r, w1, b⟩ hw
    simp only [WP.uncurry'_pair, uncurry, WP.spec_ok] at hw ⊢
    have : (IScalar.hcast .U128 v).val = (v : I128).bv.toNat := by
      have hb := (v : I128).bv.isLt
      simp [UScalar.val, IScalar.hcast_bv_eq] <;> omega
    simpa [this] using hw.wrap

