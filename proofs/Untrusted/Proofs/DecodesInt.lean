instance _root_.untrusted.bytes.LittleEndianI128.Insts.UntrustedReaderDecode.decode.spec :
    DecodesAs LittleEndianI128.Insts.UntrustedReaderDecode
      (fun l x k => k = 16 ∧ 16 ≤ l.length ∧ (x : I128).bv = BitVec.ofNat 128 (leNat (l.take 16)))
      (fun l => l.length < 16) where
  spec r h := by
    simp only [LittleEndianI128.Insts.UntrustedReaderDecode.decode]
    apply WP.spec_mono (Reader.read.LittleEndianI128_spec r h)
    rintro ⟨_ | _, r'⟩ hpost
    · obtain ⟨hle, hv, hin, hpos, hinv⟩ := hpost
      exact ⟨hin, hinv, 16, ⟨rfl, hle, hv⟩, hpos⟩
    · obtain ⟨hlt, -, rfl⟩ := hpost
      exact ⟨rfl, h, hlt⟩
  disjoint _ _ _ hD hF := Nat.lt_irrefl _ (Nat.lt_of_lt_of_le hF hD.2.1)
  functional _ v _ v' _ hD hD' := ⟨(IScalar.eq_equiv_bv_eq (v : I128) v').mpr (hD.2.2.trans hD'.2.2.symm), hD.1.trans hD'.1.symm⟩

end untrusted.reader
